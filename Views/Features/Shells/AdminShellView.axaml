<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EduPath.Avalonia.ViewModels"
             x:Class="EduPath.Avalonia.Views.AdminShellView"
             x:DataType="vm:AdminShellViewModel">

  <!-- Chia màn hình: Cột trái Sidebar (260px) - Cột phải Nội dung -->
  <Grid ColumnDefinitions="260, *">

    <!-- ========================================== -->
    <!-- CỘT TRÁI: SIDEBAR MENU DÀNH CHO ADMIN      -->
    <!-- ========================================== -->
    <Border Grid.Column="0" Background="{StaticResource NavyBrush}" Padding="16,24,16,24">
  <Grid RowDefinitions="Auto, *, Auto">

        <!-- 1. HEADER (LOGO & TÊN HỆ THỐNG) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="10,0,0,32">
          <Border Background="{StaticResource GoldBrush}" CornerRadius="8" Width="40" Height="40">
            <TextBlock Text="DL" FontSize="20" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="DKHP" FontWeight="Bold" FontSize="18" Foreground="White" />
            <TextBlock Text="Hệ thống học phần" FontSize="12" Foreground="#93a4bd" />
          </StackPanel>
        </StackPanel>

        <!-- 2. DANH SÁCH MENU ĐIỀU HƯỚNG -->
        <ListBox Grid.Row="1" ItemsSource="{Binding NavItems}"
                 SelectedItem="{Binding SelectedNav}"
                 Background="Transparent" BorderThickness="0">
          
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="16,14" />
              <Setter Property="Margin" Value="0,4" />
              <Setter Property="CornerRadius" Value="8" />
              <Setter Property="Cursor" Value="Hand" />
            </Style>
            <!-- Trạng thái mặc định -->
            <Style Selector="ListBoxItem TextBlock">
              <Setter Property="Foreground" Value="#c9d6e8" />
              <Setter Property="FontWeight" Value="Medium" />
              <Setter Property="FontSize" Value="14.5" />
            </Style>
            <!-- Trạng thái hover -->
            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
              <Setter Property="Background" Value="#142c4c" /> 
            </Style>
            <!-- Trạng thái đang chọn (Active) -->
            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
              <Setter Property="Background" Value="{StaticResource NavyLightBrush}" />
            </Style>
            <Style Selector="ListBoxItem:selected TextBlock">
              <Setter Property="Foreground" Value="{StaticResource GoldTextBrush}" />
            </Style>
          </ListBox.Styles>

          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <!-- Hiển thị Icon từ file ảnh PNG -->
                <Image Source="{Binding IconPath}" Width="20" Height="20" 
                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- 3. FOOTER (ĐĂNG XUẤT) -->
        <StackPanel Grid.Row="2" Spacing="16">
          <Border Height="1" Background="#1e3656" Margin="10,0" />
          
          <Button Command="{Binding LogoutCommand}" Background="Transparent" BorderThickness="0" 
                  HorizontalAlignment="Stretch" Padding="16,14" CornerRadius="8" Cursor="Hand">
            <Button.Styles>
               <Style Selector="Button:pointerover /template/ ContentPresenter">
                  <Setter Property="Background" Value="#142c4c" />
               </Style>
            </Button.Styles>
            <StackPanel Orientation="Horizontal" Spacing="14">
              <TextBlock Text="[→" FontSize="16" Foreground="#c9d6e8" VerticalAlignment="Center" /> 
              <TextBlock Text="Đăng xuất" Foreground="#c9d6e8" FontSize="14.5" FontWeight="Medium" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

      </Grid>
    </Border>

    <!-- ========================================== -->
    <!-- CỘT PHẢI: NỘI DUNG TRANG CHÍNH CỦA ADMIN   -->
    <!-- ========================================== -->
    <Border Grid.Column="1" Background="{StaticResource BgBrush}">
      <ScrollViewer>
        <Border Padding="32">
          <TransitioningContentControl Content="{Binding CurrentPage}" MaxWidth="1400" HorizontalAlignment="Stretch">
            <TransitioningContentControl.PageTransition>
              <CrossFade Duration="0:0:0.2" /> 
            </TransitioningContentControl.PageTransition>
          </TransitioningContentControl>
        </Border>
      </ScrollViewer>
    </Border>

  </Grid>
</UserControl>