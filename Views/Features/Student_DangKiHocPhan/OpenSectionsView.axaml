<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EduPath.Avalonia.ViewModels"
             x:Class="EduPath.Avalonia.Views.OpenSectionsView"
             x:Name="Root"
             x:DataType="vm:OpenSectionsViewModel">

  <!-- CHIA 2 CỘT: Cột trái (Nội dung) và Cột phải (Danh sách đã chọn & Validation) -->
  <Grid ColumnDefinitions="*, 400" Background="{StaticResource BgBrush}">

    <!-- ========================================== -->
    <!-- CỘT TRÁI: MAIN CONTENT                     -->
    <!-- ========================================== -->
    <Grid Grid.Column="0" RowDefinitions="Auto, Auto, Auto, *, *" Margin="24">

      <!-- 1. KHUNG CHÀO SINH VIÊN (NAVY BACKGROUND) -->
      <Border Grid.Row="0" Background="{StaticResource NavyBrush}" CornerRadius="12" Padding="24" Margin="0,0,0,24">
        <Grid ColumnDefinitions="*, Auto">
          <!-- Thông tin sinh viên -->
          <StackPanel Grid.Column="0">
            <TextBlock Text="{Binding StudentWelcomeText}" FontSize="24" FontWeight="Bold" Foreground="White" />
            <TextBlock Text="{Binding StudentInfoText}" FontSize="14" Foreground="#93a4bd" Margin="0,6,0,4" />
            <TextBlock Text="{Binding RegistrationDateText}" FontSize="13" Foreground="#93a4bd" />
          </StackPanel>

          <!-- Status Badges (Vàng = Mở, Đỏ = Đóng) -->
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <!-- Badge Vàng (Đang Mở) -->
            <Border Background="{StaticResource GoldBrush}" CornerRadius="6" Padding="12,6" IsVisible="{Binding IsRegistrationOpen}">
              <TextBlock Text="{Binding RegistrationStatusText}" Foreground="{StaticResource NavyBrush}" FontWeight="Bold" FontSize="12" />
            </Border>
            <!-- Badge Đỏ (Đã Đóng) -->
            <Border Background="#ef4444" CornerRadius="6" Padding="12,6" IsVisible="{Binding !IsRegistrationOpen}">
              <TextBlock Text="{Binding RegistrationStatusText}" Foreground="White" FontWeight="Bold" FontSize="12" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- FEEDBACK SYSTEM THÔNG BÁO TỪ VIEWMODEL -->
      <Border Grid.Row="1" Classes.feedback-error="{Binding !IsRegistrationOpen}" Classes.feedback-ok="{Binding IsRegistrationOpen}" CornerRadius="8" Padding="12" Margin="0,0,0,16" IsVisible="{Binding HasFeedback}">
        <TextBlock Text="{Binding Feedback}" FontWeight="Medium" />
      </Border>

      <!-- 2. MỘT Ô TÌM KIẾM DUY NHẤT -->
      <TextBox Grid.Row="2" Watermark="🔍 Tìm theo mã lớp, tên môn, giảng viên..." Text="{Binding SearchText}" Classes="rounded" Margin="0,0,0,20" Padding="14,10" FontSize="14" />

      <!-- 3. BẢNG MÔN BẮT BUỘC (Cuộn độc lập) -->
      <Grid Grid.Row="3" RowDefinitions="Auto, *" Margin="0,0,0,20">
        <TextBlock Grid.Row="0" Text="HỌC PHẦN BẮT BUỘC" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,10" />
        <DataGrid Grid.Row="1" ItemsSource="{Binding RequiredSections}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="8" MaxHeight="500">
          <DataGrid.Columns>
            <!-- Môn bắt buộc hiển thị đậm (FontWeight="Bold") -->
            <DataGridTemplateColumn Header="Mã lớp" Width="1.2*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding SectionId}" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Tên môn học" Width="2*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding CourseName}" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Giảng viên" Binding="{Binding LecturerName}" Width="1.5*" />
            <DataGridTextColumn Header="TC" Binding="{Binding Credits}" Width="0.8*" />
            <DataGridTemplateColumn Header="Thao tác" Width="1*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Content="Thêm" Classes="outline" Padding="8,4" FontSize="12" HorizontalAlignment="Center" Command="{Binding #Root.((vm:OpenSectionsViewModel)DataContext).RegisterCommand}" CommandParameter="{Binding}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>

      <!-- 4. BẢNG MÔN TỰ CHỌN (Cuộn độc lập) -->
      <Grid Grid.Row="4" RowDefinitions="Auto, *">
        <TextBlock Grid.Row="0" Text="HỌC PHẦN TỰ CHỌN" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,10" />
        <DataGrid Grid.Row="1" ItemsSource="{Binding ElectiveSections}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="8">
          <DataGrid.Columns>
            <!-- Môn tự chọn hiển thị Font bình thường -->
            <DataGridTextColumn Header="Mã lớp" Binding="{Binding SectionId}" Width="1.2*" />
            <DataGridTextColumn Header="Tên môn học" Binding="{Binding CourseName}" Width="2*" />
            <DataGridTextColumn Header="Giảng viên" Binding="{Binding LecturerName}" Width="1.5*" />
            <DataGridTextColumn Header="TC" Binding="{Binding Credits}" Width="0.8*" />
            <DataGridTemplateColumn Header="Thao tác" Width="1*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Content="Thêm" Classes="outline" Padding="8,4" FontSize="12" HorizontalAlignment="Center" Command="{Binding #Root.((vm:OpenSectionsViewModel)DataContext).RegisterCommand}" CommandParameter="{Binding}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>

    </Grid>


    <!-- ========================================== -->
    <!-- CỘT PHẢI: PANEL ĐÃ CHỌN & VALIDATION       -->
    <!-- ========================================== -->
    <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1,0,0,0" Padding="24">
      <Grid RowDefinitions="Auto, *, Auto, Auto">

        <TextBlock Grid.Row="0" Text="LỚP ĐÃ CHỌN" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,16" />

        <!-- 5. DANH SÁCH LỚP ĐÃ CHỌN -->
        <ScrollViewer Grid.Row="1" Margin="0,0,0,20">
          <ItemsControl ItemsSource="{Binding SelectedSections}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12" Background="#f8fafc">
                  <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                      <TextBlock Text="{Binding CourseName}" FontWeight="Bold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding SectionId}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                      <TextBlock Text="{Binding Credits, StringFormat='Số TC: {0}'}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" Classes="outline" Padding="6" VerticalAlignment="Top" Command="{Binding #Root.((vm:OpenSectionsViewModel)DataContext).RemoveSelectedCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- 6. VALIDATION PANEL -->
        <Border Grid.Row="2" Background="#f8fafc" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,20">
          <StackPanel Spacing="10">
            <TextBlock Text="ĐIỀU KIỆN ĐĂNG KÝ" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,4" />
            
            <Grid ColumnDefinitions="*, Auto">
              <TextBlock Grid.Column="0" Text="Môn bắt buộc:" FontSize="13" Foreground="{StaticResource TextMutedBrush}" />
              <TextBlock Grid.Column="1" Text="{Binding RequiredSummaryText}" FontSize="13" FontWeight="SemiBold" />
            </Grid>
            <Grid ColumnDefinitions="*, Auto">
              <TextBlock Grid.Column="0" Text="Tín chỉ tự chọn:" FontSize="13" Foreground="{StaticResource TextMutedBrush}" />
              <TextBlock Grid.Column="1" Text="{Binding ElectiveSummaryText}" FontSize="13" FontWeight="SemiBold" />
            </Grid>
            <Grid ColumnDefinitions="*, Auto">
              <TextBlock Grid.Column="0" Text="Tổng số tín chỉ:" FontSize="13" Foreground="{StaticResource TextMutedBrush}" />
              <TextBlock Grid.Column="1" Text="{Binding SelectedSummaryText}" FontSize="13" FontWeight="SemiBold" />
            </Grid>

            <Separator Background="{StaticResource BorderBrush2}" Margin="0,4" />

            <!-- Trạng thái Validation động -->
            <TextBlock Text="{Binding RegistrationValidationMessage}" FontSize="13" TextWrapping="Wrap" FontWeight="Medium" Foreground="{Binding CanSubmit, Converter={x:Static ObjectConverters.IsNull}}" />
          </StackPanel>
        </Border>

        <!-- 7. THAO TÁC -->
        <Grid Grid.Row="3" ColumnDefinitions="*, *" Margin="0,10,0,0">
          <!-- Nút Xóa Toàn Bộ -->
          <Button Grid.Column="0" Content="Xóa toàn bộ" Classes="outline" HorizontalAlignment="Stretch" Margin="0,0,6,0" Command="{Binding ClearAllCommand}" />
          <!-- Nút Gửi Đăng Ký (Tự động khóa nhờ CanSubmit) -->
          <Button Grid.Column="1" Content="Gửi đăng ký" Classes="primary" HorizontalAlignment="Stretch" Margin="6,0,0,0" Command="{Binding SubmitRegistrationCommand}" />
        </Grid>

      </Grid>
    </Border>
  </Grid>
</UserControl>