<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EduPath.Avalonia.ViewModels"
             x:Class="EduPath.Avalonia.Views.LoginView"
             x:DataType="vm:LoginViewModel">

  <Grid ColumnDefinitions="1.1*,1*">

    <!-- ===== Bảng thương hiệu bên trái (thay cho form đăng nhập đơn giản của bản gốc) ===== -->
    <Border Grid.Column="0" Background="{StaticResource NavyBrush}" ClipToBounds="True">
      <Grid>
        <!-- vòng tròn trang trí mờ, tạo chiều sâu -->
        <Ellipse Width="420" Height="420" Fill="{StaticResource NavyLightBrush}" Opacity="0.5"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-160,-160,0" />
        <Ellipse Width="300" Height="300" Fill="{StaticResource GoldBrush}" Opacity="0.12"
                  HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-100,0,0,-100" />

        <StackPanel VerticalAlignment="Center" Margin="72,0" Spacing="18" MaxWidth="460">
          <Border Background="{StaticResource GoldBrush}" CornerRadius="12" Width="100" Height="100">
            <TextBlock Text="🎓" FontSize="100" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="DLU" FontSize="34" FontWeight="Bold" Foreground="White" />
          <TextBlock Text="Hệ thống quản lý đăng ký học phần"
                     FontSize="16" Foreground="#c9d6e8" TextWrapping="Wrap" />
          <TextBlock Margin="0,20,0,0" Foreground="#93a4bd" TextWrapping="Wrap" LineHeight="22"
                     Text="Đăng ký, hủy học phần, theo dõi thời khóa biểu và tín chỉ trong một giao diện gọn gàng — dành cho cả Sinh viên và Quản trị viên." />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== Khối form đăng nhập bên phải ===== -->
    <Grid Grid.Column="1" Background="{StaticResource BgBrush}">
      <Border Classes="card" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
        <StackPanel Spacing="6">
          <TextBlock Text="Đăng nhập" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />
          <TextBlock Text="Chọn vai trò và nhập thông tin tài khoản" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14" />
                  <!-- 
                  Toggle vai trò dạng segmented control 
                  khi đăng nhập kiểm tra trong DB nếu tài khoản được cấp quyền admin thì tự login vào admin, người dùng không cần tương tác nhiều 
                  <Border Background="{StaticResource BgBrush}" CornerRadius="10" Padding="4" Margin="0,0,0,14">
                    <Grid ColumnDefinitions="*,*">
                      <Button Grid.Column="0" Content="Sinh viên" Command="{Binding SelectStudentRoleCommand}"
                              Classes="outline" BorderThickness="0" HorizontalContentAlignment="Center"
                              Classes.primary="{Binding IsStudentRole}" />
                      <Button Grid.Column="1" Content="Quản trị" Command="{Binding SelectAdminRoleCommand}"
                              Classes="outline" BorderThickness="0" HorizontalContentAlignment="Center"
                              Classes.primary="{Binding IsAdminRole}" />
                    </Grid>
                  </Border> -->

          <TextBlock Text="Tên đăng nhập" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,4" />
          <TextBox Classes="rounded" Text="{Binding Username}" Watermark="VD: SV20260018" />

          <TextBlock Text="Mật khẩu" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,4" />
          <TextBox Classes="rounded" Text="{Binding Password}" PasswordChar="●" Watermark="••••••" />

          <Border Background="#fdecec" CornerRadius="8" Padding="10,8" Margin="0,12,0,0" IsVisible="{Binding HasError}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#b3261e" TextWrapping="Wrap" FontSize="12.5" />
          </Border>

          <Button Content="Đăng nhập" Classes="primary" Command="{Binding LoginCommand}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,18,0,0" />

          <TextBlock Margin="0,16,0,0" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                     Text="Quên mật khẩu?. Liên hệ quản trị viên để được hỗ trợ. 
                     (admin MK: 111) (sinhvien MK: 000)" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
