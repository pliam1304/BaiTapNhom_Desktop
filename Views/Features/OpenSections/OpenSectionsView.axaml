<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EduPath.Avalonia.ViewModels"
             xmlns:behaviors="using:EduPath.Avalonia.Behaviors"
             x:Class="EduPath.Avalonia.Views.OpenSectionsView"
             x:Name="Root"
             x:DataType="vm:StudentOpenSectionsViewModel">

  <StackPanel Spacing="18">

    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" Spacing="2">
        <TextBlock Text="Đăng ký học phần" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />
        <TextBlock Text="Chọn lớp học phần đang mở đăng ký cho học kỳ hiện hành." Foreground="{StaticResource TextMutedBrush}" />
      </StackPanel>
      <TextBox Grid.Column="1" Classes="rounded" Width="260" VerticalAlignment="Center"
               Watermark="🔍 Tìm theo tên/mã học phần…" Text="{Binding SearchText}" />
    </Grid>

    <Border behaviors:ClassBinding.Value="{Binding FeedbackClass}" CornerRadius="8" Padding="12,9" IsVisible="{Binding HasFeedback}">
      <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" />
    </Border>

    <ItemsControl ItemsSource="{Binding Sections}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="12" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:SectionRow">
          <Border Classes="card" Padding="18">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
              <StackPanel Grid.Column="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding CourseName}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextDarkBrush}" />
                  <TextBlock Text="{Binding CourseCode}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock FontSize="12.5" Foreground="{StaticResource TextMutedBrush}">
                  <Run Text="{Binding SectionId}" /> · <Run Text="{Binding Schedule}" /> · Phòng <Run Text="{Binding RoomId}" /> · GV <Run Text="{Binding LecturerName}" />
                </TextBlock>
              </StackPanel>

              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0" Spacing="2" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Credits, StringFormat='{}{0} TC'}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding SeatsLabel}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
              </StackPanel>

              <Border Grid.Column="2" behaviors:ClassBinding.Value="{Binding StatusBadge}" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="{Binding StatusText}" />
              </Border>

              <Button Grid.Column="3" Content="Đăng ký" Classes="primary" VerticalAlignment="Center"
        Command="{Binding #Root.((vm:StudentOpenSectionsViewModel)DataContext).RegisterCommand}"
        CommandParameter="{Binding}" IsEnabled="{Binding !IsFull}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Text="Không có lớp học phần nào phù hợp." Foreground="{StaticResource TextMutedBrush}"
               IsVisible="{Binding NoResults}" Margin="0,20,0,0" HorizontalAlignment="Center" />
  </StackPanel>
</UserControl>
