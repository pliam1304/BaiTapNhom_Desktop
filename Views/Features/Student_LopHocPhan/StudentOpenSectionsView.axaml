<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EduPath.Avalonia.ViewModels"
             xmlns:models="using:EduPath.Avalonia.Models"
             xmlns:behaviors="using:EduPath.Avalonia.Behaviors"
             x:Class="EduPath.Avalonia.Views.StudentOpenSectionsView"
             x:Name="Root"
             x:DataType="vm:StudentOpenSectionsViewModel"> <!-- ✅ Sửa tên ViewModel -->

  <ScrollViewer Padding="0,0,16,16">
    <StackPanel Spacing="18">

      <!-- ===== HEADER ===== -->
      <StackPanel Spacing="2">
        <TextBlock Text="ĐĂNG KÝ HỌC PHẦN" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />
        <TextBlock Text="Xem danh sách các lớp học phần đang mở và tiến hành đăng ký." Foreground="{StaticResource TextMutedBrush}" />
      </StackPanel>

      <!-- ===== THANH LỌC & TÌM KIẾM ===== -->
      <Grid ColumnDefinitions="Auto, Auto, Auto">
        <ComboBox Grid.Column="0" SelectedIndex="0" Width="200" Margin="0,0,12,0" Classes="rounded">
          <ComboBoxItem>Học Kỳ 1 (2026-2027)</ComboBoxItem>
        </ComboBox>
        <!-- ✅ Đã thêm Text="{Binding SearchText}" -->
        <TextBox Grid.Column="1" Watermark="🔍 Tìm mã lớp, mã môn..." Width="260" Classes="rounded" Margin="0,0,12,0"
                 Text="{Binding SearchText}"/> 
        <Button Grid.Column="2" Content="Lọc nâng cao ▽" Classes="outline" />
      </Grid>

      <!-- ✅ HIỂN THỊ THÔNG BÁO (Feedback) TỪ VIEWMODEL -->
      <Border behaviors:ClassBinding.Value="{Binding FeedbackClass}" CornerRadius="8" Padding="12,9" IsVisible="{Binding HasFeedback}">
        <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" />
      </Border>

      <!-- ===== DANH SÁCH LỚP HỌC PHẦN ĐANG MỞ ===== -->
      <Border Classes="card" Padding="0">
        <Grid RowDefinitions="Auto, *">
          
          <!-- TIÊU ĐỀ BẢNG -->
          <Border Grid.Row="0" Background="{StaticResource BgBrush}" Padding="16,12" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="1.2*, 3*, 2*, 1.2*, 1.8*, 1.2*, Auto">
              <TextBlock Grid.Column="0" Text="Mã lớp HP" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
              <TextBlock Grid.Column="1" Text="Tên môn học" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
              <TextBlock Grid.Column="2" Text="Giảng viên" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
              <TextBlock Grid.Column="3" Text="Sĩ số / Tối đa" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
              <TextBlock Grid.Column="4" Text="Thời khóa biểu" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
              <TextBlock Grid.Column="5" Text="Trạng thái" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" FontSize="12" HorizontalAlignment="Center"/>
              <TextBlock Grid.Column="6" Text="Thao tác" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Width="100" HorizontalAlignment="Center"/>
            </Grid>
          </Border>

          <!-- NỘI DUNG BẢNG -->
          <ListBox Grid.Row="1" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" 
                   Background="Transparent" BorderThickness="0">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
              </Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="#f0f6ff" /> 
              </Style>
            </ListBox.Styles>

            <ListBox.ItemTemplate>
              <!-- ✅ Sửa lại cú pháp khai báo DataType cho Avalonia và chỉ định đúng SectionRow -->
              <DataTemplate x:DataType="vm:SectionRow">
                
                <Grid ColumnDefinitions="1.2*, 3*, 2*, 1.2*, 1.8*, 1.2*, Auto">
                  <TextBlock Grid.Column="0" Text="{Binding SectionId}" FontWeight="Bold" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding CourseName}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding LecturerName}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding SeatsLabel}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="{Binding Schedule}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" FontSize="13" />
                  
                  <Border Grid.Column="5" behaviors:ClassBinding.Value="{Binding StatusBadge}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" />
                  </Border>

                  <!-- ✅ Đã sửa lại đường dẫn Binding cast đúng StudentOpenSectionsViewModel -->
                  <Button Grid.Column="6" Content="Đăng ký" Classes="primary" Padding="8,4" FontSize="11" Width="80" HorizontalContentAlignment="Center" VerticalAlignment="Center"
                          Command="{Binding #Root.((vm:StudentOpenSectionsViewModel)DataContext).RegisterCommand}"
                          CommandParameter="{Binding}"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- ✅ HIỂN THỊ KHI TÌM KIẾM KHÔNG CÓ KẾT QUẢ -->
          <TextBlock Grid.Row="1" Text="Không có lớp học phần nào phù hợp." Foreground="{StaticResource TextMutedBrush}"
                     IsVisible="{Binding NoResults}" Margin="0,20,0,20" HorizontalAlignment="Center" />

        </Grid>
      </Border>

      <!-- ===== BẢNG CHI TIẾT ===== -->
      <Border Classes="card" Margin="0,4,0,0" IsVisible="{Binding IsDetailVisible}" Background="White">
        <StackPanel Spacing="16">
          
          <Grid ColumnDefinitions="*, Auto">
            <TextBlock Text="{Binding SelectedSection.SectionId, StringFormat='Chi tiết lớp học phần: {0}'}" 
                       FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" />
            <!-- ✅ Sử dụng Method Binding cho nút Đóng (CloseDetail) thay vì Command -->
            <Button Grid.Column="1" Content="✕" Classes="outline" Command="{Binding CloseDetail}" BorderThickness="0" Padding="8,4" />
          </Grid>

          <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="24">
              <TextBlock Text="Thông tin chung" FontWeight="Bold" Foreground="{StaticResource GoldTextBrush}" />
              <TextBlock Text="Thời khóa biểu" Foreground="{StaticResource TextMutedBrush}" />
              <TextBlock Text="Điều kiện tiên quyết" Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="1.2*, 1*, 2*" Margin="0,10,0,0">
            <!-- Cột 1: Thông tin môn học -->
            <StackPanel Grid.Column="0" Spacing="8">
              <TextBlock Text="Thông tin lớp học phần" FontWeight="Bold" Margin="0,0,0,8" />
              <Grid ColumnDefinitions="120, *" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,0,16,0">
                 <TextBlock Grid.Row="0" Grid.Column="0" Text="Mã lớp học phần:" Foreground="{StaticResource TextMutedBrush}" Margin="0,4"/>
                 <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedSection.SectionId}" FontWeight="SemiBold" Margin="0,4"/>
                 
                 <TextBlock Grid.Row="1" Grid.Column="0" Text="Môn học:" Foreground="{StaticResource TextMutedBrush}" Margin="0,4"/>
                 <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSection.CourseName}" Margin="0,4" TextWrapping="Wrap"/>
                 
                 <TextBlock Grid.Row="2" Grid.Column="0" Text="Số tín chỉ:" Foreground="{StaticResource TextMutedBrush}" Margin="0,4"/>
                 <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedSection.Credits}" Margin="0,4"/> 
              </Grid>
            </StackPanel>

            <!-- Cột 2: Giảng viên -->
            <StackPanel Grid.Column="1" Spacing="20">
              <StackPanel Spacing="8">
                <TextBlock Text="Giảng viên" FontWeight="Bold" />
                <Grid ColumnDefinitions="100, *" RowDefinitions="Auto">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Giảng viên chính:" Foreground="{StaticResource TextMutedBrush}" Margin="0,4"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedSection.LecturerName}" FontWeight="SemiBold" Margin="0,4" TextWrapping="Wrap"/>
                </Grid>
              </StackPanel>
            </StackPanel>

            <!-- Cột 3: Lịch học dự kiến -->
            <Border Grid.Column="2" Background="#f8fafc" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Padding="12">
              <StackPanel Spacing="10">
                 <TextBlock Text="Lịch học dự kiến" FontWeight="Bold" />
                 <Border Background="White" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="4">
                   <Grid RowDefinitions="Auto, Auto">
                     <Border Grid.Row="0" Background="{StaticResource BgBrush}" Padding="8">
                       <Grid ColumnDefinitions="*,*,*,*">
                         <TextBlock Grid.Column="0" Text="Lịch học" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                         <TextBlock Grid.Column="1" Text="Tiết học" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                         <TextBlock Grid.Column="2" Text="Loại tiết" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                         <TextBlock Grid.Column="3" Text="Phòng học" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                       </Grid>
                     </Border>
                     <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0" Padding="8,12">
                       <Grid ColumnDefinitions="*,*,*,*">
                         <TextBlock Grid.Column="0" Text="{Binding SelectedSection.Schedule}" FontSize="12" />
                         <TextBlock Grid.Column="1" Text="Tiết 1-3" FontSize="12" />
                         <TextBlock Grid.Column="2" Text="Lý thuyết" FontSize="12" />
                         <TextBlock Grid.Column="3" Text="{Binding SelectedSection.RoomId}" FontSize="12" />
                       </Grid>
                     </Border>
                   </Grid>
                 </Border>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>