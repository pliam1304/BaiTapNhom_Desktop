<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EduPath.Avalonia.ViewModels"
             xmlns:models="using:EduPath.Avalonia.Models"
             xmlns:behaviors="using:EduPath.Avalonia.Behaviors"
             x:Class="EduPath.Avalonia.Views.StudentOpenSectionsView"
             x:Name="Root"
             x:DataType="vm:StudentOpenSectionsViewModel">

    <!-- Bước 4: Bọc toàn bộ trong ScrollViewer để cuộn khi nội dung dài -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Padding="0,0,16,16">
        <StackPanel Spacing="18">

            <!-- ===== HEADER ===== -->
            <StackPanel Spacing="2">
                <TextBlock Text="ĐĂNG KÝ HỌC PHẦN" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource TextDarkBrush}" />
                <TextBlock Text="Xem danh sách các lớp học phần đang mở và tiến hành đăng ký." 
                           Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>

            <!-- ===== THANH LỌC & TÌM KIẾM ===== -->
            <Grid ColumnDefinitions="Auto, Auto, Auto">
                <ComboBox Grid.Column="0" 
                          SelectedIndex="0" 
                          Width="200" 
                          Margin="0,0,12,0" 
                          Classes="rounded">
                    <ComboBoxItem>Học Kỳ 1 (2026-2027)</ComboBoxItem>
                </ComboBox>
                <TextBox Grid.Column="1" 
                         Watermark="🔍 Tìm mã lớp, mã môn..." 
                         Width="260" 
                         Classes="rounded" 
                         Margin="0,0,12,0"
                         Text="{Binding SearchText}" />
                <Button Grid.Column="2" 
                        Content="Lọc nâng cao ▽" 
                        Classes="outline" />
            </Grid>

            <!-- ===== HIỂN THỊ THÔNG BÁO ===== -->
            <Border behaviors:ClassBinding.Value="{Binding FeedbackClass}" 
                    CornerRadius="8" 
                    Padding="12,9" 
                    IsVisible="{Binding HasFeedback}">
                <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" />
            </Border>

            <!-- ============================================================ -->
            <!-- BẢNG LỚP HỌC PHẦN - ĐÃ TỐI ƯU CHIỀU CAO VÀ CUỘN NỘI BỘ    -->
            <!-- ============================================================ -->
            <!-- Bước 1: Thêm MaxHeight để bảng ngắn lại (khoảng 5-6 hàng)   -->
            <!-- Bước 2: ListBox tự động có thanh cuộn khi nội dung vượt quá -->
            <!-- ============================================================ -->
            <Border Classes="card" 
                    Padding="0" 
                    MaxHeight="600">
                <Grid RowDefinitions="Auto, *">

                    <!-- TIÊU ĐỀ BẢNG (CỐ ĐỊNH) -->
                    <Border Grid.Row="0" 
                            Background="{StaticResource BgBrush}" 
                            Padding="16,12" 
                            BorderBrush="{StaticResource BorderBrush2}" 
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="1.2*, 3*, 2*, 1.2*, 1.8*, 1.2*, Auto">
                            <TextBlock Grid.Column="0" 
                                       Text="Mã lớp HP" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource TextMutedBrush}" 
                                       FontSize="12" />
                            <TextBlock Grid.Column="1" 
                                       Text="Tên môn học" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource TextMutedBrush}" 
                                       FontSize="12" />
                            <TextBlock Grid.Column="2" 
                                       Text="Giảng viên" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource TextMutedBrush}" 
                                       FontSize="12" />
                            <TextBlock Grid.Column="3" 
                                       Text="Sĩ số / Tối đa" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource TextMutedBrush}" 
                                       FontSize="12" />
                            <TextBlock Grid.Column="4" 
                                       Text="Thời khóa biểu" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource TextMutedBrush}" 
                                       FontSize="12" />
                            <TextBlock Grid.Column="5" 
                                       Text="Trạng thái" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource TextMutedBrush}" 
                                       FontSize="12" 
                                       HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="6" 
                                       Text="Thao tác" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource TextMutedBrush}" 
                                       FontSize="12" 
                                       Width="100" 
                                       HorizontalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- NỘI DUNG BẢNG - CÓ THANH CUỘN NỘI BỘ -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Sections}"
                             SelectedItem="{Binding SelectedSection}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListBox.Styles>
                            <!-- Giảm padding để hiển thị thêm hàng -->
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="12,10" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                            </Style>
                            <!-- Màu nền khi chọn -->
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="#f0f6ff" />
                            </Style>
                            <!-- Hover effect -->
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#f5f8ff" />
                            </Style>
                        </ListBox.Styles>

                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SectionRow">
                                <Grid ColumnDefinitions="1.2*, 3*, 2*, 1.2*, 1.8*, 1.2*, Auto">
                                    <!-- Mã lớp HP -->
                                    <TextBlock Grid.Column="0" 
                                               Text="{Binding SectionId}" 
                                               FontWeight="Bold" 
                                               VerticalAlignment="Center" />

                                    <!-- Tên môn học (có cắt ngắn nếu dài) -->
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding CourseName}" 
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Giảng viên (có cắt ngắn nếu dài) -->
                                    <TextBlock Grid.Column="2" 
                                               Text="{Binding LecturerName}" 
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Sĩ số / Tối đa -->
                                    <TextBlock Grid.Column="3" 
                                               Text="{Binding SeatsLabel}" 
                                               VerticalAlignment="Center" />

                                    <!-- Thời khóa biểu -->
                                    <TextBlock Grid.Column="4" 
                                               Text="{Binding Schedule}" 
                                               Foreground="{StaticResource TextMutedBrush}" 
                                               VerticalAlignment="Center" 
                                               FontSize="13" />

                                    <!-- Trạng thái (badge) -->
                                    <Border Grid.Column="5" 
                                            behaviors:ClassBinding.Value="{Binding StatusBadge}" 
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" />
                                    </Border>

                                    <!-- Nút Đăng ký -->
                                    <Button Grid.Column="6"
                                            Content="Đăng ký"
                                            Classes="primary"
                                            Padding="8,4"
                                            FontSize="11"
                                            Width="80"
                                            HorizontalContentAlignment="Center"
                                            VerticalAlignment="Center"
                                            Command="{Binding #Root.((vm:StudentOpenSectionsViewModel)DataContext).RegisterCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- HIỂN THỊ KHI KHÔNG CÓ KẾT QUẢ TÌM KIẾM -->
                    <TextBlock Grid.Row="1"
                               Text="Không có lớp học phần nào phù hợp."
                               Foreground="{StaticResource TextMutedBrush}"
                               IsVisible="{Binding NoResults}"
                               Margin="0,20,0,20"
                               HorizontalAlignment="Center" />

                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- BẢNG CHI TIẾT LỚP HỌC PHẦN                                  -->
            <!-- ============================================================ -->
            <Border Classes="card" 
                    Margin="0,4,0,0" 
                    IsVisible="{Binding IsDetailVisible}" 
                    Background="White">
                <StackPanel Spacing="16">

                    <!-- TIÊU ĐỀ VÀ NÚT ĐÓNG -->
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="{Binding SelectedSection.SectionId, StringFormat='Chi tiết lớp học phần: {0}'}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextDarkBrush}" />
                        <Button Grid.Column="1"
                                Content="✕"
                                Classes="outline"
                                Command="{Binding CloseDetail}"
                                BorderThickness="0"
                                Padding="8,4" />
                    </Grid>

                    <!-- MENU TABS -->
                    <Border BorderBrush="{StaticResource BorderBrush2}"
                            BorderThickness="0,0,0,1"
                            Padding="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <TextBlock Text="Thông tin chung"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GoldTextBrush}" />
                            <TextBlock Text="Thời khóa biểu"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="Điều kiện tiên quyết"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>

<!-- NỘI DUNG CHI TIẾT -->
<ScrollViewer MaxHeight="450"
              Margin="0,12,0,0"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">
    <Grid ColumnDefinitions="1.3*, 1*, 2.4*">

        <!-- Cột 1 -->
        <StackPanel Grid.Column="0" Spacing="8">
            <TextBlock Text="Thông tin lớp học phần" FontWeight="Bold" Margin="0,0,0,8"/>
            <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Mã lớp học phần:" Foreground="{StaticResource TextMutedBrush}" Margin="0,5"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedSection.SectionId}" FontWeight="SemiBold" Margin="0,5"/>
                
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Môn học:" Foreground="{StaticResource TextMutedBrush}" Margin="0,5"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSection.CourseName}" TextWrapping="Wrap" Margin="0,5"/>
                
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Số tín chỉ:" Foreground="{StaticResource TextMutedBrush}" Margin="0,5"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedSection.Credits}" Margin="0,5"/>
            </Grid>
        </StackPanel>

        <!-- Cột 2 -->
        <StackPanel Grid.Column="1" Spacing="8">
            <TextBlock Text="Giảng viên" FontWeight="Bold"/>
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="Giảng viên chính:" Foreground="{StaticResource TextMutedBrush}" Margin="0,5"/>
                <TextBlock Grid.Column="1" Text="{Binding SelectedSection.LecturerName}" FontWeight="SemiBold" Margin="8,5,0,5" TextWrapping="Wrap"/>
            </Grid>
        </StackPanel>

        <!-- Cột 3: Lịch học dự kiến – CAO HƠN + CUỘN -->
        <Border Grid.Column="2"
                Background="#f8fafc"
                BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14">
            <StackPanel Spacing="12">
                <TextBlock Text="Lịch học dự kiến" FontWeight="Bold"/>

                <!-- Khung chính – đủ chỗ ~4 hàng -->
                <Border Background="White"
        BorderBrush="{StaticResource BorderBrush2}"
        BorderThickness="1"
        CornerRadius="6"
        MinHeight="120"
        MaxHeight="260">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <!-- Header -->
            <Border Background="{StaticResource BgBrush}" Padding="10,11">
                <Grid ColumnDefinitions="*,*,*,*">
                    <TextBlock Grid.Column="0" Text="Lịch học" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Grid.Column="1" Text="Tiết học" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Grid.Column="2" Text="Loại tiết" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Grid.Column="3" Text="Phòng học" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                </Grid>
            </Border>

            <!-- Nhiều hàng dữ liệu -->
            <ItemsControl ItemsSource="{Binding SelectedSection.Schedules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderBrush2}"
                                BorderThickness="0,1,0,0"
                                Padding="10,12">
                            <Grid ColumnDefinitions="*,*,*,*">
                                <TextBlock Grid.Column="0" Text="{Binding DisplaySchedule}" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding Periods}" FontSize="13"/>
                                <TextBlock Grid.Column="2" Text="{Binding SessionType}" FontSize="13"/>
                                <TextBlock Grid.Column="3" Text="{Binding RoomId}" FontSize="13"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Border>
            </StackPanel>
        </Border>
    </Grid>
</ScrollViewer>
               </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>