<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EduPath.Avalonia.ViewModels"
        x:Class="EduPath.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="EduPath — Quản lý đăng ký học phần"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    
    <!-- Cách 1: Dùng TransitioningContentControl để có hiệu ứng chuyển trang -->
    <TransitioningContentControl Content="{Binding CurrentView}">
        <TransitioningContentControl.PageTransition>
            <CrossFade Duration="0:0:0.28" />
        </TransitioningContentControl.PageTransition>
    </TransitioningContentControl>
    
</Window>